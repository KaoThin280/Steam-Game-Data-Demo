# ============== App ==============
APP_NAME="Steam Game Data API"
DEBUG=False
ENABLE_LEGACY_AI=False
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ============== Security ==============
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key-min-32-chars
ALGORITHM=HS256
JWT_ISSUER=steam-game-data-api
JWT_AUDIENCE=steam-game-data-client
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============== Database (Aiven PostgreSQL) ==============
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Hoặc:   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require  (sẽ tự convert)
DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Read-only DB user for AI SQL execution (defense-in-depth)
# Create with: back_end/db_readonly_user.sql
# Required. The API refuses to start without this separate restricted role.
DATABASE_URL_READONLY=postgresql://steam_readonly:PASSWORD@HOST:PORT/postgres
DB_SSL_VERIFY=True

# ============== Redis (Upstash) ==============
# Có thể dùng 1 trong 2 format:
# (1) REDIS_URL đầy đủ (khuyến nghị):
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# (2) Hoặc tách riêng host/port/password:
# REDIS_HOST=your-host.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password
REDIS_TTL=3600

# ============== Rate Limit ==============
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20

# ============== CORS ==============
# Comma-separated, ví dụ:
# CORS_ORIGINS=["https://your-frontend.vercel.app","http://localhost:3000"]
CORS_ORIGINS=["https://your-frontend.vercel.app"]

# ============== OpenRouter AI ==============
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model chính (free tier khuyến nghị):
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
# Model fallback khi model chính lỗi:
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT=60

# ============== AI-assisted error email (optional) ==============
# The error is redacted and truncated before being sent to OpenRouter.
# For Gmail, use an App Password instead of the normal account password.
ERROR_NOTIFICATIONS_ENABLED=False
ERROR_NOTIFICATION_TO=alerts@example.com
ERROR_NOTIFICATION_ENVIRONMENT=production
ERROR_NOTIFICATION_MIN_INTERVAL_SECONDS=300
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=sender@example.com
SMTP_STARTTLS=True
AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT=12
AGENT_HISTORY_RUNS=20
AGENT_EVENT_MAX_BYTES=65536

# ============== Internal MCP tool server ==============
# API :8000 calls the independently running tool server :8001.
# Generate a different random value from SECRET_KEY (openssl rand -hex 32).
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_SHARED_SECRET=replace-with-a-random-mcp-secret-min-32-chars

# ============== E2B Sandbox ==============
E2B_API_KEY=e2b_xxxxxxxxxxxx
E2B_TEMPLATE=base
E2B_TIMEOUT=60

# ============== Steam (optional - chỉ khi muốn gọi Steam API) ==============
STEAM_API_KEY=

# ============== Bootstrap Admin (tạo admin đầu tiên khi start app) ==============
# Nếu để trống thì KHÔNG tự tạo admin (cần tạo thủ công qua /api/v1/auth/register)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
