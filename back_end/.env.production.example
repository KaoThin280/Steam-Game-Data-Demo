# Protected VPS file: copy to .env.production beside compose.production.yml.
# Set this tag from image-tag.txt in the tested release artifact.
BACKEND_IMAGE=steam-backend:REPLACE_WITH_COMMIT_SHA
# Default: host reverse proxy forwards to loopback:8000. Confirm actual public route.
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
API_MEMORY_LIMIT=384m
MCP_MEMORY_LIMIT=256m
API_CPU_LIMIT=0.12
MCP_CPU_LIMIT=0.08
DATABASE_URL=postgresql://APP_ROLE.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL_READONLY=postgresql://READONLY_ROLE.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
REDIS_URL=rediss://default:REPLACE@UPSTASH_HOST:6379
# Retain protected VPS secrets where valid, not secrets pasted into chat.
SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
MCP_SHARED_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
ALGORITHM=HS256
JWT_ISSUER=steam-game-data-api
JWT_AUDIENCE=steam-game-data-client
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://REPLACE_WITH_HOSTED_FRONTEND"]
OPENROUTER_API_KEY=REPLACE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=openrouter/owl-alpha
LLM_TIMEOUT=60
AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT=12
AGENT_HISTORY_RUNS=20
AGENT_EVENT_MAX_BYTES=65536
E2B_API_KEY=REPLACE
E2B_TEMPLATE=base
E2B_TIMEOUT=60
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ERROR_NOTIFICATIONS_ENABLED=False
