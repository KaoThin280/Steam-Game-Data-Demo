# Copy to .env.docker.local. Shared Supabase is permitted only with explicit owner authorization.
# compose.local.yml disables startup recovery/bootstrapping; app writes still affect the shared DB.
DATABASE_URL=postgresql://dev_owner:REPLACE@DEV_HOST:5432/postgres
DATABASE_URL_READONLY=postgresql://dev_readonly:REPLACE@DEV_HOST:5432/postgres
DB_SSL_VERIFY=True
REDIS_URL=rediss://default:REPLACE@DEV_UPSTASH_HOST:6379
# Generate TWO separate random secrets (at least 32 characters each).
SECRET_KEY=REPLACE
MCP_SHARED_SECRET=REPLACE
OPENROUTER_API_KEY=REPLACE
E2B_API_KEY=REPLACE
# Set model IDs to the same verified values used on the VPS if comparing behavior.
# OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODEL=

# Optional RAG: keep disabled until corpus upload/search has been verified.
RAG_ENABLED=False
PINECONE_API_KEY=
PINECONE_INDEX_NAME=steam-knowledge
PINECONE_NAMESPACE=project-starter-v2
PINECONE_TEXT_FIELD=text

# compose.local.yml enforces false when sharing Supabase with another API.
AGENT_RECOVERY_ENABLED=False
