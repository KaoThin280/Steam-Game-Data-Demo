# ============== Environment & Secrets ==============
# QUAN TRỌNG: back_end/.env chứa secrets thật (DB password, API keys, SECRET_KEY...)
# LUÔN LUÔN ignore .env ở mọi nơi, chỉ commit .env.example
.env
.env.local
.env.*.local
**/.env
**/.env.local

# ============== Python ==============
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
.venv*/
env*/
ENV/

