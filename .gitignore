# ============== back_end: Personal/debug scripts ==============
# Các file bắt đầu bằng _ trong back_end/ là script test/debug cá nhân
# (vd: _e2e_test.py, _smoke_test.py, _verify_db.py)
# KHÔNG phải test suite chính thức - không commit lên repo
back_end/_*.py
!back_end/__init__.py
!back_end/app/__init__.py
!back_end/app/**/__init__.py

