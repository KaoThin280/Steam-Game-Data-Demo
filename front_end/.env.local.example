# Public base URL of the back-end API (no trailing slash).
#
# For local development, use the absolute URL of your local BE:
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# For Vercel deployment, use a relative path so Vercel Rewrites can
# proxy requests to the BE. This avoids mixed-content errors
# (Vercel serves the FE over HTTPS, but the BE may be HTTP).
#   NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_URL=/api/v1
